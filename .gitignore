# Simulation scratch (Phase 1+): LAMMPS runs produce large trajectories that
# must not enter version control. Keep inputs and extracted results, not dumps.
*.lammpstrj
*.dump
log.lammps
restart.*
runs/
scratch/

# test fixtures keep their LAMMPS logs (measure_kapitza reads the relaxed box from them)
!tests/data/**/log.lammps
